<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/JetpackSplashTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TensorIMS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LogcatActivity"
            android:exported="false"
            android:theme="@style/Theme.TensorIMS" />

        <provider
            android:name=".ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.NETWORK_SETTINGS" />
        <!-- shell/root bootstrap 不持有自定义 signature 权限；Provider 内逐次认证 UID 与挑战。 -->
        <provider
            android:name=".embedded.EmbeddedBridgeProvider"
            android:authorities="${applicationId}.embedded.bridge"
            android:exported="true"
            android:multiprocess="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logcat_fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/logcat_filepaths" />
        </provider>
    </application>

    <!-- 顶层 Instrumentation 不依赖相对包名展开，保证旧 applicationId 仍加载统一代码类。 -->
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.ImsConfigurationReader"
        android:label="ImsConfigurationReader"
        android:targetPackage="${applicationId}" />

    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.ImsModifier"
        android:label="IMS Configurator"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.SimReader"
        android:label="SimReader"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.BrokerInstrumentation"
        android:label="BrokerInstrumentation"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.ImsCapabilityReader"
        android:label="ImsCapabilityReader"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.ImsResetter"
        android:label="ImsResetter"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.PersistentVolteModifier"
        android:label="PersistentVolteModifier"
        android:targetPackage="${applicationId}" />
    <instrumentation
        android:name="app.mystery0.ims.tensor.privileged.CaptivePortalSettingsModifier"
        android:label="CaptivePortalSettingsModifier"
        android:targetPackage="${applicationId}" />
</manifest>
